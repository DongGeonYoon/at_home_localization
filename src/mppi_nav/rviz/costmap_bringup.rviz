Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
    - Class: rviz_default_plugins/Map
      Name: Structural Map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Map
      Name: Static Costmap
      Enabled: true
      Color Scheme: costmap
      Alpha: 0.6
      Topic:
        Value: /mppi_static_costmap/costmap
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Map
      Name: Local Costmap
      Enabled: true
      Color Scheme: costmap
      Alpha: 0.7
      Topic:
        Value: /local_costmap/costmap
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/PointCloud2
      Name: Current Scan In Map
      Enabled: true
      Topic:
        Value: /cur_scan_in_map
        Reliability Policy: Best Effort
      Size (Pixels): 3
      Style: Points
    - Class: rviz_default_plugins/PointCloud2
      Name: Raw Body Cloud
      Enabled: false
      Topic:
        Value: /cloud_registered_body
        Reliability Policy: Reliable
      Size (Pixels): 3
      Style: Points
      Color Transformer: FlatColor
      Color: 255; 0; 0
    - Class: rviz_default_plugins/PointCloud2
      Name: Local Obstacle Cloud (self-filtered)
      Enabled: true
      Topic:
        Value: /local_obstacle_cloud
        Reliability Policy: Reliable
      Size (Pixels): 3
      Style: Points
      Color Transformer: FlatColor
      Color: 255; 255; 0
    - Class: rviz_default_plugins/Polygon
      Name: Robot Footprint
      Enabled: true
      Color: 0; 255; 0
      Topic:
        Value: /local_costmap/published_footprint
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
    - Class: rviz_default_plugins/Odometry
      Name: Localization
      Enabled: true
      Topic:
        Value: /localization
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
Window Geometry:
  Height: 900
  Width: 1400
